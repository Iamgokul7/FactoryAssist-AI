APP_NAME=FactoryAssist AI
APP_VERSION=1.0.0
DEBUG=False

# Leave empty in this template. Copy this file to .env and add your own key.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=60
# Gemini 3+ only: minimal | low | medium | high | off
GEMINI_THINKING_LEVEL=low

EMBEDDING_BATCH_SIZE=24
CHROMA_ACTIVE_COLLECTION=factoryassist_active_documents
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.30
MAX_QUESTION_LENGTH=1000

CHROMA_PERSIST_DIRECTORY=vector_store/chroma_db
ACTIVE_DOCUMENTS_DIRECTORY=documents/active
ARCHIVED_DOCUMENTS_DIRECTORY=documents/archived
SAMPLE_QUESTIONS_DIRECTORY=documents/sample_questions
PROCESSED_DATA_DIRECTORY=data/processed

# --- Document management ---
# Records, sessions and audit log (SQLite) live here; uploads are stored as PDFs.
MANAGED_DATA_DIRECTORY=data/managed
UPLOADS_DIRECTORY=documents/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Authentication and access control ---
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=fa_session
# auto = Secure cookie only when served over HTTPS; true = always Secure.
SESSION_COOKIE_SECURE=auto
LOGIN_MAX_ATTEMPTS=5
# Higher, address-wide threshold; stops spraying across many account names
# without letting one mistyped password lock out a shared plant network.
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_MINUTES=15

# First administrator, used once when the database has no accounts yet.
# Leave blank here; set real values in .env (never commit them).
# Alternatively run: python -m backend.services.auth_store create-admin --username admin
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Plant Administrator

CHUNK_SIZE=900
CHUNK_OVERLAP=150

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
